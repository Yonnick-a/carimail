generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  passwordHash      String?
  emailVerified     DateTime?
  image             String?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?   // AES-256-CBC encrypted TOTP secret
  backupCodes       String    @default("[]") // JSON array of bcrypt-hashed backup codes
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts      MailAccount[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  teamMemberships TeamMember[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model MailAccount {
  id                String    @id @default(cuid())
  userId            String
  label             String?
  emailAddress      String
  imapHost          String
  imapPort          Int       @default(993)
  imapSecure        Boolean   @default(true)
  smtpHost          String
  smtpPort          Int       @default(465)
  smtpSecure        Boolean   @default(true)
  encryptedPassword String
  authType          String    @default("password")
  oauthProvider     String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  oauthExpiresAt    DateTime?
  isPrimary         Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          MailMessage[]
  conversations     MailConversation[]
  rules             MailRule[]
  scheduledEmails   ScheduledEmail[]
  snoozes           MailSnooze[]
  reminders         MailReminder[]
  signatures        MailSignature[]
  trackingPixels    EmailTrackingPixel[]
  messageCategories MessageCategory[]
  teamShares        TeamMailAccount[]

  @@index([userId])
  @@index([emailAddress])
  @@unique([userId, emailAddress])
}

model MailConversation {
  id             String   @id @default(cuid())
  accountId      String
  threadKey      String
  subject        String
  participants   String   @default("")
  messageCount   Int      @default(0)
  unreadCount    Int      @default(0)
  hasAttachment  Boolean  @default(false)
  lastMessageAt  DateTime
  snippet        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account        MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages       MailMessage[]

  @@unique([accountId, threadKey])
  @@index([accountId, lastMessageAt])
}

model MailMessage {
  id             String   @id @default(cuid())
  accountId      String
  conversationId String?
  folder         String
  uid            Int
  seq            Int
  messageId      String?
  inReplyTo      String?
  references     String?
  subject        String
  from           String
  fromName       String
  to             String
  date           DateTime
  seen           Boolean  @default(false)
  flagged        Boolean  @default(false)
  hasAttachment  Boolean  @default(false)
  size           Int?
  snippet        String?
  syncedAt       DateTime @default(now())

  account        MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation   MailConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([accountId, folder, uid])
  @@index([accountId, folder, date])
  @@index([accountId, messageId])
  @@index([conversationId])
}

model MailRule {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  field       String
  operator    String   @default("contains")
  value       String
  action      String
  destination String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, isActive])
}

model ScheduledEmail {
  id          String    @id @default(cuid())
  accountId   String
  payload     Json
  scheduledAt DateTime
  sentAt      DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sentAt])
  @@index([accountId])
}

model MailSnooze {
  id        String   @id @default(cuid())
  accountId String
  folder    String
  uid       Int
  until     DateTime
  createdAt DateTime @default(now())

  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, folder, uid])
  @@index([until])
}

model MailReminder {
  id        String    @id @default(cuid())
  accountId String
  folder    String
  uid       Int
  remindAt  DateTime
  note      String?
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, remindAt])
  @@index([doneAt])
}

model MailSignature {
  id        String   @id @default(cuid())
  accountId String
  name      String
  html      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, isDefault])
}

// ── Email tracking ─────────────────────────────────────────────────────────

model EmailTrackingPixel {
  id          String    @id @default(cuid())
  accountId   String
  to          String
  subject     String
  opens       Int       @default(0)
  lastOpenAt  DateTime?
  clicks      Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())

  events  EmailTrackEvent[]
  account MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model EmailTrackEvent {
  id        String   @id @default(cuid())
  pixelId   String
  type      String   // "open" | "click"
  url       String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  pixel     EmailTrackingPixel @relation(fields: [pixelId], references: [id], onDelete: Cascade)

  @@index([pixelId, type])
}

// ── AI message categories ──────────────────────────────────────────────────

model MessageCategory {
  id        String   @id @default(cuid())
  accountId String
  folder    String
  uid       Int
  category  String   // primary|updates|promotions|social|finance|security|notifications
  source    String   @default("heuristic") // heuristic | ai
  createdAt DateTime @default(now())

  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, folder, uid])
  @@index([accountId, folder])
}

// ── Teams ──────────────────────────────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        TeamMember[]
  invites        TeamInvite[]
  sharedAccounts TeamMailAccount[]

  @@index([ownerId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member") // owner | admin | member
  joinedAt DateTime @default(now())

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id        String    @id @default(cuid())
  teamId    String
  email     String
  token     String    @unique
  role      String    @default("member")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
}

model TeamMailAccount {
  id        String      @id @default(cuid())
  teamId    String
  accountId String
  addedAt   DateTime    @default(now())

  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([teamId, accountId])
}
