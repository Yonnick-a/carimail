      "icons": [{ "src": "/logo.webp", "sizes": "96x96" }]
    },
    {
      "name": "Compose",
      "short_name": "Compose",
      "description": "Write a new email",
      "url": "/inbox?compose=1",
      "icons": [{ "src": "/logo.webp", "sizes": "96x96" }]
    }
  ],
