{
  "name": "Carimail — Email by Hostcari",
  "short_name": "Carimail",
  "description": "A polished, privacy-first email client that works with any IMAP/SMTP provider.",
  "start_url": "/inbox",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F5F7FB",
  "theme_color": "#F97316",
  "categories": ["productivity", "utilities"],
