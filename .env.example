# Carimail — Environment Variables
# Copy this to .env.local and fill in the values

# Database — can share with portal or use separate DB
DATABASE_URL="postgresql://user:password@host:5432/carimail"

# Encryption key for stored IMAP passwords (32+ random characters)
CARIMAIL_ENCRYPTION_SECRET="replace-with-32-plus-random-characters-here"

# App URL
NEXT_PUBLIC_APP_URL="https://mail.hostcari.com"

# SMTP for system emails (password reset). Format: smtp://user:pass@host:587
# Without this, reset URLs are only logged to the server console.
SMTP_URL=""
EMAIL_FROM="Carimail <noreply@hostcari.com>"

# Optional: Anthropic API key for AI email categorisation
ANTHROPIC_API_KEY=""
